# ANSHUL STUDENT ERP — Environment Variables Example
# Duplicate this file as .env (or configure in Vercel Project Settings -> Environment Variables)

# Supabase Project URL (plain project URL without /rest/v1 or trailing slashes)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anonymous API Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
